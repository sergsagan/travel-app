{
  "name": "travel-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently \"npm run dev:db\" \"nuxt dev\"",
    "dev:db": "turso dev --db-file local.db",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:one": "vitest run -t"
  },
  "dependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@libsql/client": "^0.17.0",
    "@nuxt/eslint": "^1.12.1",
    "@nuxt/icon": "^2.2.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "better-auth": "^1.4.12",
    "concurrently": "^9.1.2",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "eslint": "^9.39.2",
    "nanoid": "^5.1.6",
    "nuxt": "^4.2.2",
    "nuxt-maplibre": "^1.2.2",
    "pinia": "^3.0.4",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.26",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "^25.0.6",
    "@types/slug": "^5.0.9",
    "@vue/test-utils": "^2.4.6",
    "daisyui": "^5.5.14",
    "drizzle-kit": "^0.31.8",
    "eslint-plugin-format": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
